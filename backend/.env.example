# DeepSeek（方案 C：八 Agent 真模型）
# 复制为 .env 或在 shell 中 export；不要提交真实 Key
DEEPSEEK_API_KEY=

# 博查联网搜索（生产由 Nginx 注入，与根目录 .env / Vite 同名）
# BOCHA_API_KEY=

# 可选覆盖（默认已对齐 DeepSeek OpenAI 兼容端点）
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro

# 离线演示（强制 Mock，不调外网）：
# LLM_PROVIDER=mock

# ---------- 生产部署（见 deploy/DEPLOY.md）----------
# 仅本机监听，公网走 Nginx :80
MAWP_HOST=127.0.0.1
MAWP_PORT=8787
MAWP_RELOAD=0
# 生产必须关闭验证码回显
AUTH_DEV_MODE=0

# ---------- 手机号 / 邮箱验证码登录 ----------
# 管理员白名单（验证码登录后自动升为 admin）
# 把你的真实邮箱/手机号写在这里，然后执行：
#   cd backend && PYTHONPATH=src python -m mawp.auth.bootstrap_admin
AUTH_ADMIN_EMAILS=wzt@example.com
AUTH_ADMIN_PHONES=13800138000
AUTH_ADMIN_NAME=Admin

# 开发联调：1=验证码会打日志/回显（勿用于生产）
# AUTH_DEV_MODE=1

# 邮箱验证码（SMTP，真实发信）
# 例：QQ 邮箱 smtp.qq.com:465，授权码作 SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 短信验证码（阿里云短信，真实发送）
# 控制台：https://dysms.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_REGION=cn-hangzhou

# ---------- 腾讯云实时语音识别（密钥只放后端，勿提交 Git）----------
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_APP_ID=
# TENCENT_ASR_ENGINE=16k_zh

# ---------- 图像生成（Pollinations，可选）----------
# https://enter.pollinations.ai
# POLLINATIONS_API_KEY=
