# DeepSeek：仅用于智能对话 + 写作/需求分析 + 八 Agent 链路（backend）
DEEPSEEK_API_KEY=

# 博查 Bocha：联网搜索（https://open.bochaai.com ）
BOCHA_API_KEY=

# 本地测试账号入口：开发环境默认开启；生产构建需显式设置为 true 才显示
VITE_ENABLE_LOCAL_TEST_LOGIN=false
# 短信/邮箱验证码相关配置写在 backend/.env（见 backend/.env.example）

# 后续可接（当前图像默认 Pollinations Flux）
