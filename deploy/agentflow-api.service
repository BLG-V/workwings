[Unit]
Description=智流 AgentFlow MAWP API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/agentflow/backend
Environment=PYTHONPATH=/opt/agentflow/backend/src
Environment=MAWP_HOST=127.0.0.1
Environment=MAWP_PORT=8787
Environment=MAWP_RELOAD=0
EnvironmentFile=-/opt/agentflow/backend/.env
ExecStart=/opt/agentflow/.venv/bin/python -m mawp.api.server
Restart=always
RestartSec=3
# 给 Deliver / 长任务足够时间
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
